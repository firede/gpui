#!/usr/bin/env bash
# What must pass before main is tagged (SYNC.md). On macOS it also checks that
# the Windows crates build for Windows, in debug and release, without the
# Windows SDK; Linux is checked on Linux.

set -euo pipefail
cd "$(dirname "$0")/.."

# Zed's toolchain, even where the environment picks another (mise sets
# RUSTUP_TOOLCHAIN, which wins over rust-toolchain.toml): a newer Clippy has
# lints Zed's code doesn't pass yet.
toolchain=$(sed -n 's/^channel = "\(.*\)"$/\1/p' rust-toolchain.toml)
cargo() { command cargo "+$toolchain" "$@"; }

set -x
cargo check -p gpui-pre -p gpui-pre-platform -p gpui-pre-macros
case "$(uname -s)" in
    Darwin)
        cargo clippy -p gpui -p gpui_platform -p gpui_macos -p gpui_apple --all-targets -- --deny warnings
        cargo test -p gpui --lib
        # gpui's default `windows-manifest` feature needs a resource compiler
        # for Windows, which a macOS host doesn't have.
        for profile in dev release; do
            cargo check --profile "$profile" -p gpui -p gpui_windows --no-default-features --features gpui/font-kit \
                --target x86_64-pc-windows-msvc
        done
        ;;
    Linux)
        cargo clippy -p gpui -p gpui_platform -p gpui_linux -p gpui_wgpu --all-targets -- --deny warnings
        cargo test -p gpui --lib
        ;;
    *)
        cargo clippy -p gpui -p gpui_platform -p gpui_windows --all-targets -- --deny warnings
        cargo test -p gpui --lib
        ;;
esac
